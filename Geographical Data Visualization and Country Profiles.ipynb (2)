{"nbformat":4,"nbformat_minor":0,"metadata":{"colab":{"provenance":[]},"kernelspec":{"name":"python3","display_name":"Python 3"},"language_info":{"name":"python"}},"cells":[{"cell_type":"code","source":["import folium\n","import pandas as pd\n","\n","# Country Profiles\n","countries = pd.DataFrame({\n","    'Country': ['South Africa', 'DRC (Congo)', 'Namibia', 'Mozambique'],\n","    'Latitude': [-30.5595, -2.8, -22.6, -18.6],\n","    'Longitude': [22.9375, 23.7, 17.1, 35.5],\n","    'GDP_BillionUSD': [350, 55, 15, 20],\n","    'MiningRevenue_BillionUSD': [25, 12, 3, 4],\n","})\n","\n","# Major Mineral Deposits\n","deposits = pd.DataFrame({\n","    'Country': ['South Africa', 'South Africa', 'DRC (Congo)', 'Namibia', 'Mozambique'],\n","    'DepositName': ['Waterberg Lithium Mine', 'Waterberg Lithium Mine', 'Kolwezi Mine', 'Otjozondu Manganese', 'Balama Graphite Mine'],\n","    'Mineral': ['Lithium', 'Lithium', 'Cobalt', 'Manganese', 'Graphite'],\n","    'Latitude': [-24.5, -24.5, -10.7, -22.0, -13.3],\n","    'Longitude': [28.5, 28.5, 25.5, 17.2, 38.2],\n","    'Production_tonnes': [40000, 40000, 95000, 30000, 12000]\n","})\n","\n","# Mineral Color Mapping\n","mineral_colors = {\n","    'Lithium': 'blue',\n","    'Cobalt': 'darkblue',\n","    'Manganese': 'brown',\n","    'Graphite': 'gray'\n","}\n","\n","# Initialize Map\n","map_center = [-10, 25]\n","m = folium.Map(location=map_center, zoom_start=3, tiles='cartodb positron')\n","\n","# Add Country Markers\n","for _, row in countries.iterrows():\n","    folium.Marker(\n","        location=[row['Latitude'], row['Longitude']],\n","        popup=f\"<h4>{row['Country']}</h4><b>GDP:</b> {row['GDP_BillionUSD']} Billion USD<br><b>Mining Revenue:</b> {row['MiningRevenue_BillionUSD']} Billion USD\",\n","        icon=folium.Icon(color='darkblue', icon='flag')\n","    ).add_to(m)\n","\n","# Add Mineral Deposit Markers\n","for _, row in deposits.iterrows():\n","    folium.CircleMarker(\n","        location=[row['Latitude'], row['Longitude']],\n","        radius=6,\n","        color=mineral_colors.get(row['Mineral'], 'orange'),\n","        fill=True,\n","        fill_color=mineral_colors.get(row['Mineral'], 'orange'),\n","        fill_opacity=0.7,\n","        popup=f\"<b>Deposit:</b> {row['DepositName']}<br><b>Mineral:</b> {row['Mineral']}<br><b>Production:</b> {row['Production_tonnes']} tonnes\"\n","    ).add_to(m)\n","\n","# Add Mineral Legend\n","legend_html = '''\n","    <div style=\"position: absolute; bottom: 10px; left: 10px; width: 180px; height: 130px;\n","                background-color: white; opacity: 0.8; padding: 10px; font-size: 12px; border-radius: 5px;\n","                z-index: 1000; border: 2px solid grey;\">\n","        <h4>Mineral Legend</h4>\n","        <ul style=\"list-style-type: none; padding: 0;\">\n","            <li><i style=\"background-color: blue; padding: 5px;\"></i> Lithium</li>\n","            <li><i style=\"background-color: darkblue; padding: 5px;\"></i> Cobalt</li>\n","            <li><i style=\"background-color: brown; padding: 5px;\"></i> Manganese</li>\n","            <li><i style=\"background-color: gray; padding: 5px;\"></i> Graphite</li>\n","        </ul>\n","    </div>\n","'''\n","\n","folium.Marker(\n","    location=map_center,\n","    icon=folium.DivIcon(html=legend_html)\n",").add_to(m)\n","\n","# Display map\n","m\n","# Save map to HTML\n","m.save(\"map.html\")\n"],"metadata":{"id":"oOC7Cwn2HZzH","executionInfo":{"status":"ok","timestamp":1760604051300,"user_tz":-120,"elapsed":48,"user":{"displayName":"Roshudufhadzwa Muvhango","userId":"05907784156365221091"}}},"execution_count":3,"outputs":[]},{"cell_type":"code","source":[],"metadata":{"id":"8l47MJrRe9W5"},"execution_count":null,"outputs":[]}]}